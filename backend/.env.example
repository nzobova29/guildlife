DATABASE_URL=postgresql+psycopg://guildlife:guildlife@localhost:5432/guildlife
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Set true when served over HTTPS in production.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
# AI is disabled until credentials, model and a positive budget are configured.
# Provide either authorization key (OAuth) OR short-lived access token.
GIGACHAT_AUTH_KEY=
GIGACHAT_ACCESS_TOKEN=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Optional trusted CA PEM path; TLS certificate verification stays enabled.
GIGACHAT_CA_BUNDLE=
AI_DAILY_CALL_BUDGET=0
AI_TIMEOUT_SECONDS=30
